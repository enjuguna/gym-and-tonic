---
import "../styles/global.css";
import InfoPage from "../components/InfoPage.astro";
---
<InfoPage title="Guidance, not diagnosis." eyebrow="Training, with judgement" accent="terra" description="Gym & Tonic helps organise a training rhythm. You remain in charge of how, when, and whether you train.">
  <section class="mt-12 grid gap-5 lg:grid-cols-3"><article class="surface-card p-6"><span class="text-2xl" aria-hidden="true">◌</span><h2 class="mt-4 font-display text-2xl font-semibold">Work within your day</h2><p class="mt-3 text-sm leading-6 text-[var(--muted)]">The board is a plan, not a demand. Adjust intensity, rest, or leave a session empty when life needs room.</p></article><article class="surface-card p-6"><span class="text-2xl" aria-hidden="true">↗</span><h2 class="mt-4 font-display text-2xl font-semibold">Stop when something feels wrong</h2><p class="mt-3 text-sm leading-6 text-[var(--muted)]">Seek appropriate professional guidance for pain, injury, pregnancy, medical conditions, or changes in health.</p></article><article class="surface-card p-6"><span class="text-2xl" aria-hidden="true">✓</span><h2 class="mt-4 font-display text-2xl font-semibold">Keep the final say</h2><p class="mt-3 text-sm leading-6 text-[var(--muted)]">WebMCP coaches may inspect and propose changes, but every plan change stays staged for your approval.</p></article></section>
  <section class="mt-12 grid gap-8 border-t border-[var(--line)] pt-10 md:grid-cols-2"><div><p class="eyebrow text-[var(--terra)]">What Gym &amp; Tonic is</p><p class="mt-3 text-sm leading-7 text-[var(--muted)]">A general planning, guided-workout, and reflection tool designed to help a useful session happen.</p></div><div><p class="eyebrow text-[var(--terra)]">What it is not</p><p class="mt-3 text-sm leading-7 text-[var(--muted)]">It is not medical advice, injury diagnosis, a nutrition prescription, or a substitute for a qualified healthcare or fitness professional.</p></div></section>
</InfoPage>
