---
import { toolSpecs } from "../lib/webmcp";
const specs = toolSpecs();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gym &amp; Tonic — Site tools reference</title>
  </head>
  <body class="min-h-screen bg-[#f7f5ef] px-4 py-10 text-[#26251f]">
    <main class="mx-auto max-w-3xl">
      <a href="/" class="text-sm text-stone-400 hover:underline">← Back to the grid</a>
      <h1 class="mt-3 font-serif text-3xl font-bold tracking-tight">Gym &amp; Tonic site tools</h1>
      <p class="mt-2 text-stone-600">
        Gym &amp; Tonic registers these {specs.length} tools with any WebMCP-compatible agent
        (ChatGPT desktop built-in browser, Chrome with WebMCP). Your coach can inspect the week,
        generate sessions, and check balance — but every change to the plan is staged as a
        <strong>pending proposal you approve</strong>. The agent never silently touches your training week.
      </p>
      <div class="mt-8 space-y-5">
        {specs.map((t) => (
          <section class="rounded-2xl border border-[#e6e1d4] bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-mono text-lg font-semibold">{t.name}</h2>
              <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${t.readOnly ? "bg-sky-100 text-sky-800" : "bg-emerald-100 text-emerald-800"}`}>
                {t.readOnly ? "read-only" : "writes via your approval"}
              </span>
            </div>
            <p class="mt-1 text-sm text-stone-600">{t.description}</p>
            <details class="mt-3">
              <summary class="cursor-pointer text-xs uppercase tracking-wide text-stone-400">Input schema</summary>
              <pre class="mt-2 overflow-x-auto rounded-lg bg-zinc-900 p-3 text-xs text-zinc-100">{JSON.stringify(t.inputSchema, null, 2)}</pre>
            </details>
          </section>
        ))}
      </div>
      <footer class="mt-10 border-t border-[#e6e1d4] pt-5 text-center text-xs text-stone-400">
        Tools live on the page — close the tab and they're gone. Nothing runs without your open session.
      </footer>
    </main>
  </body>
</html>
