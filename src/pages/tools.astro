---
import "../styles/global.css";
import InfoPage from "../components/InfoPage.astro";
import { toolSpecs } from "../lib/webmcp";
const specs = toolSpecs();
const readTools = specs.filter((tool) => tool.readOnly);
const proposalTools = specs.filter((tool) => !tool.readOnly);
---
<InfoPage title="A coach that asks first." eyebrow="WebMCP site tools" description={`${specs.length} browser tools let a compatible coach understand your week and suggest changes without taking control.`}>
  <section class="mt-12 grid gap-5 md:grid-cols-3"><article class="surface-card p-5"><p class="font-display text-4xl text-[var(--sage)]">{readTools.length}</p><h2 class="mt-3 font-display text-xl font-semibold">Read tools</h2><p class="mt-2 text-sm leading-6 text-[var(--muted)]">A coach can inspect the week, balance, gear, progress, and local history.</p></article><article class="surface-card p-5"><p class="font-display text-4xl text-[var(--terra)]">{proposalTools.length}</p><h2 class="mt-3 font-display text-xl font-semibold">Proposal tools</h2><p class="mt-2 text-sm leading-6 text-[var(--muted)]">Changes are staged on your board for a human decision.</p></article><article class="surface-card p-5"><p class="font-display text-4xl text-[var(--ink)]">0</p><h2 class="mt-3 font-display text-xl font-semibold">Silent changes</h2><p class="mt-2 text-sm leading-6 text-[var(--muted)]">A coach cannot quietly alter your plan or mark your workout complete.</p></article></section>
  <section class="mt-12 rounded-[1.5rem] bg-[var(--ink)] p-6 text-white sm:p-8"><p class="eyebrow text-[#f2b36f]">The permission model</p><h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold">Inspect freely. Propose clearly. You approve every plan change.</h2><p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">Tools only exist while you have Gym &amp; Tonic open in a compatible client. They do not create an account, run in the background, or take ownership of your training.</p><a href="/plan" class="button-primary mt-6 inline-block bg-white text-[var(--sage-deep)] hover:bg-[var(--surface-subtle)]">Open planner</a></section>
  <section class="mt-12"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow text-[var(--sage)]">Tool directory</p><h2 class="mt-2 font-display text-3xl font-semibold">What your coach can do</h2></div><p class="text-xs text-[var(--muted)]">Schemas are available for technical clients.</p></div><div class="mt-7 grid gap-4 md:grid-cols-2">{specs.map((tool) => <article class="surface-card p-5"><div class="flex items-start justify-between gap-3"><h3 class="break-all font-mono text-sm font-semibold">{tool.name}</h3><span class={`shrink-0 rounded-full px-2 py-1 text-[10px] font-bold uppercase tracking-wide ${tool.readOnly ? "bg-sky-100 text-sky-800" : "bg-emerald-100 text-emerald-800"}`}>{tool.readOnly ? "Read only" : "Approval required"}</span></div><p class="mt-3 text-sm leading-6 text-[var(--muted)]">{tool.description}</p><details class="mt-4 border-t border-[var(--line)] pt-3"><summary class="cursor-pointer text-xs font-semibold text-[var(--sage-deep)]">View input schema</summary><pre class="mt-3 overflow-x-auto rounded-xl bg-[var(--ink)] p-3 text-[11px] leading-5 text-stone-100">{JSON.stringify(tool.inputSchema, null, 2)}</pre></details></article>)}</div></section>
</InfoPage>
