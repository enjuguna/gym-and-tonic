---
interface Props { title: string; eyebrow: string; description: string; accent?: "sage" | "terra"; }
const { title, eyebrow, description, accent = "sage" } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="manifest" href="/manifest.webmanifest" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta name="theme-color" content="#31572c" /><meta name="description" content={description} /><title>{title} — Gym &amp; Tonic</title></head><body class="grain min-h-screen bg-[var(--paper)] text-[var(--ink)]"><header class="border-b border-[var(--line)] bg-[var(--paper)]/90 backdrop-blur"><div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-8"><a href="/" class="font-display text-xl font-semibold tracking-tight">gym<span class="text-[var(--sage)]">&amp;</span>tonic</a><nav class="flex items-center gap-3 text-xs font-semibold sm:gap-5 sm:text-sm" aria-label="Main navigation"><a href="/" class="hidden text-[var(--muted)] hover:text-[var(--ink)] sm:block">Home</a><a href="/privacy" class="hidden text-[var(--muted)] hover:text-[var(--ink)] md:block">Privacy</a><a href="/tools" class="text-[var(--muted)] hover:text-[var(--ink)]">Coach tools</a><a href="/plan" class="button-primary px-3 py-2 text-[11px]">Open planner</a></nav></div></header><main class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16"><a href="/" class="button-quiet">← Back to Gym &amp; Tonic</a><div class="mt-10 max-w-3xl"><p class={`eyebrow ${accent === "terra" ? "text-[var(--terra)]" : "text-[var(--sage)]"}`}>{eyebrow}</p><h1 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1><p class="mt-5 max-w-2xl text-base leading-7 text-[var(--muted)]">{description}</p></div><slot /></main><footer class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 border-t border-[var(--line)] px-5 py-7 text-xs text-[var(--muted)] sm:px-8"><span>Gym &amp; Tonic · A considered training week.</span><span><a href="/privacy" class="hover:text-[var(--ink)]">Privacy</a> · <a href="/data" class="hover:text-[var(--ink)]">Data</a> · <a href="/safety" class="hover:text-[var(--ink)]">Safety</a></span></footer></body></html>
